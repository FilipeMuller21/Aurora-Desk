rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }

    // O login valida o código antes de autenticar -> leitura pública do doc.
    match /config/convites { allow get: if true; }

    // Perfil: cada usuário só lê/edita o próprio.
    match /usuarios/{uid} { allow read, write: if logado() && request.auth.uid == uid; }

    // Anotações = pessoais. Doc id {uid}_{data}, campo ownerUid.
    match /anotacoes/{id} {
      // get: permite abrir um dia ainda vazio (resource == null).
      allow get:    if logado() && (resource == null || resource.data.ownerUid == request.auth.uid);
      // list: a query do app filtra por ownerUid (carregarMes).
      allow list:   if logado() && resource.data.ownerUid == request.auth.uid;
      allow create: if logado() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if logado() && resource.data.ownerUid == request.auth.uid
                            && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if logado() && resource.data.ownerUid == request.auth.uid;
    }

    // Chamados = pessoais. Cada usuário só vê/edita os seus (campo ownerUid).
    match /chamados/{id} {
      // get: permite abrir um doc (normalmente não usado; a lista usa list).
      allow get:    if logado() && (resource == null || resource.data.ownerUid == request.auth.uid);
      // list: as queries do app filtram por ownerUid (escutarChamados/export/import).
      allow list:   if logado() && resource.data.ownerUid == request.auth.uid;
      allow create: if logado() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if logado() && resource.data.ownerUid == request.auth.uid
                            && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if logado() && resource.data.ownerUid == request.auth.uid;
    }

    // Conclusões (ranking) = pontos por chamado encerrado. Leitura por todos os
    // logados (ranking e auditoria); create/delete só do próprio dono; imutável.
    match /conclusoes/{id} {
      allow get, list: if logado();
      allow create: if logado()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.link is string
                    && request.resource.data.link.size() > 0
                    && request.resource.data.dia is string;
      allow delete: if logado() && resource.data.ownerUid == request.auth.uid;
      allow update: if false;
    }

    // Compartilhados entre usuários logados (a UI ainda não tem noção de dono aqui).
    match /casos/{id}        { allow read, write: if logado(); }
    match /links/{id}        { allow read, write: if logado(); }
    match /blocos_fixos/{id} { allow read, write: if logado(); }
    match /config/{doc=**}   { allow read, write: if logado(); }
  }
}
